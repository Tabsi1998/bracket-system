APP_ENV=production

# Public URLs
FRONTEND_URL=https://lionsquad.at
PUBLIC_BACKEND_URL=https://lionsquad.at
# Optional: DNS-only upload endpoint that bypasses Cloudflare body-size limits.
# Create upload.lionsquad.at as DNS-only and proxy it to the same frontend service.
PUBLIC_UPLOAD_BACKEND_URL=
CORS_ORIGINS=https://lionsquad.at,https://www.lionsquad.at

# Database
MONGO_USERNAME=tls_admin
# Use URL-safe characters because Compose builds MONGO_URL from this value.
MONGO_PASSWORD=change-me-generate-with-openssl-rand-hex-32
MONGO_URL=mongodb://tls_admin:change-me@mongodb:27017/?authSource=admin
DB_NAME=tls_arena

# Security
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable; changing it requires re-encrypting stored integration secrets.
SETTINGS_ENCRYPTION_KEY=change-me-generate-with-python-fernet
# Use .lionsquad.at so login cookies work on both lionsquad.at and www.lionsquad.at.
AUTH_COOKIE_DOMAIN=.lionsquad.at
PASSKEY_ENABLED=true
TRUST_PROXY_HEADERS=true
# Only these direct proxy sources may influence client IP/scheme. Narrow the
# Docker range to the actual proxy/network shown by `docker network inspect`.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
# Optional extra Host header names. FRONTEND_URL/CORS_ORIGINS are included automatically.
TRUSTED_HOSTS=
ADMIN_EMAIL=admin@lionsquad.at
# First-install only. install.sh removes this after the one-time admin bootstrap.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Version identifiers written to the consent ledger.
PRIVACY_POLICY_VERSION=2026-08-26
TERMS_VERSION=2026-08-26

# Mail fallback. Main SMTP/Resend settings are managed in the admin UI.
SENDER_EMAIL=noreply@lionsquad.at
RESEND_API_KEY=

# Runtime
BACKEND_BIND=127.0.0.1
FRONTEND_BIND=127.0.0.1
# Demo data is available only through the explicit development setup CLI.
SEED_DEMO=false
CLIENT_LOGGING_ENABLED=false
DISABLE_SCHEDULER=false
UPLOAD_DIR=/app/backend/uploads
MAX_IMAGE_UPLOAD_MB=50
MAX_VIDEO_UPLOAD_MB=1536
MAX_ORIGINAL_UPLOAD_MB=1536
MAX_DOCUMENT_UPLOAD_MB=50
# Set external reverse proxies slightly higher than app upload limits.
PROXY_UPLOAD_LIMIT_MB=1700
ADMIN_UPLOAD_RATE_LIMIT=240
ADMIN_UPLOAD_RATE_WINDOW_SECONDS=600
USER_UPLOAD_RATE_LIMIT=30
USER_UPLOAD_RATE_WINDOW_SECONDS=3600

# Optional local-only escape hatch. Never enable in production.
ALLOW_INSECURE_CORS=false
