APP_ENV=production
FRONTEND_URL=https://staging.example.at
PUBLIC_BACKEND_URL=https://staging.example.at
PUBLIC_UPLOAD_BACKEND_URL=
CORS_ORIGINS=https://staging.example.at

MONGO_USERNAME=tls_staging_admin
MONGO_PASSWORD=change-me-staging-only-random-password
DB_NAME=tls_arena_staging
JWT_SECRET=change-me-staging-only-random-secret-at-least-32-characters
SETTINGS_ENCRYPTION_KEY=change-me-generate-with-python-fernet
AUTH_COOKIE_DOMAIN=
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
TRUSTED_HOSTS=

PRIVACY_POLICY_VERSION=2026-08-26
TERMS_VERSION=2026-08-26
SENDER_EMAIL=noreply@staging.example.at
# Erst fuer gezielte Tests mit ausschliesslich Testdaten aktivieren.
DISABLE_SCHEDULER=true
CLIENT_LOGGING_ENABLED=true
BACKEND_BIND=127.0.0.1
FRONTEND_BIND=127.0.0.1
BACKEND_PORT=18001
FRONTEND_PORT=13000
MAX_IMAGE_UPLOAD_MB=50
MAX_VIDEO_UPLOAD_MB=1536
MAX_ORIGINAL_UPLOAD_MB=1536
MAX_DOCUMENT_UPLOAD_MB=50
PROXY_UPLOAD_LIMIT_MB=1700
